{
  "name": "zoeydaw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "web": "pnpm --filter @zoeydaw/web dev",
    "dev": "tauri dev",
    "build": "pnpm --filter @zoeydaw/web build",
    "check": "ultracite check && pnpm metrics:check && pnpm check:boundaries",
    "fix": "pnpm --filter @zoeymind/ui metrics:generate && ultracite fix",
    "doctor": "ultracite doctor",
    "lint": "pnpm check",
    "format": "pnpm fix",
    "metrics:check": "pnpm --filter @zoeymind/ui metrics:check",
    "test": "pnpm --filter @zoeydaw/project-core test && pnpm --filter @zoeydaw/project-runtime test && pnpm --filter @zoeydaw/web test && pnpm test:architecture && pnpm test:shared",
    "test:architecture": "vitest run tooling/eslint && pnpm check:boundaries",
    "typecheck:core": "pnpm --filter @zoeydaw/project-core typecheck && pnpm --filter @zoeydaw/project-runtime typecheck",
    "check:boundaries": "node scripts/check-core-boundaries.mjs",
    "check:realtime-protocol": "node scripts/generate-realtime-protocol.mjs --check && node --experimental-strip-types scripts/audio/verify-realtime-protocol.mjs",
    "test:shared": "vitest run packages/shared/src/__tests__ packages/logger/src/__tests__ packages/ui/src",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icon:generate": "tauri icon apps/web/src/assets/logo-framed.svg --output src-tauri/icons && node -e \"for (const path of ['src-tauri/icons/android', 'src-tauri/icons/ios', 'src-tauri/icons/64x64.png']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.9.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.9.18",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "ultracite": "8.0.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
