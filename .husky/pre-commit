#!/usr/bin/env sh

set -e

if [ -t 0 ]; then
  printf '\n> 输入「我确认」继续本次 commit（其它任何输入取消）：\n> '
  read reply < /dev/tty || reply=""
  if [ "$reply" != "我确认" ]; then
    echo ""
    echo "已取消：未收到「我确认」。" >&2
    exit 1
  fi
else
  expected_hash="$(git write-tree)"
  if [ "${USER_CONFIRM_HASH:-}" != "$expected_hash" ]; then
    cat >&2 <<EOF

BLOCKED: 非交互式提交必须显式携带 USER_CONFIRM_HASH=<staged tree sha>.

Agent 只有在用户【本次 commit 上下文】里明确说出「我确认」后才能设置.
Session 里更早的「我确认」不能复用. 每次 commit 都要新确认.

正确写法:
  USER_CONFIRM_HASH=\$(git write-tree) git commit -m "..."

当前 staged tree SHA (agent 请复现此值):
  $expected_hash

收到:
  ${USER_CONFIRM_HASH:-<未提供>}

参考: .agents/skills/commit-checklist/SKILL.md 的 G 门.

EOF
    exit 1
  fi
  {
    printf '\n=== %s ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'mode: non-interactive USER_CONFIRM_HASH match\n'
    printf 'branch: %s\n' "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    printf 'staged tree: %s\n' "$expected_hash"
    printf 'staged files:\n'
    git diff --cached --name-only | sed 's/^/  /'
  } >> "$(git rev-parse --git-dir)/commit-audit.log"
fi

pnpm exec lint-staged
