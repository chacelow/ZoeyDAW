+            let checked = HashMap::from([("aria-checked".to_string(), value.clone())]);
+            let both = HashMap::from([
+                ("aria-checked".to_string(), value),
+                ("aria-pressed".to_string(), json!(true)),
+            ]);
+            assert_eq!(toggled_prop(&both), toggled_prop(&checked));
+        }
