new file mode 100644
index 0000000..c0b9458
--- /dev/null
+++ b/packages/native/src/windows_bridge.rs
@@ -0,0 +1,356 @@
+use super::windows_protocol::{CloseProtocol, CursorCounter, FrameKind, FrameProtocol, FrameTicket, Token};
+use super::{GpuixView, UiCommand};
+use futures::channel::mpsc;
+use napi::bindgen_prelude::*;
+use napi::threadsafe_function::{ThreadsafeFunction, ThreadsafeFunctionCallMode};
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::Arc;
+use parking_lot::Mutex;
+use raw_window_handle::{HasWindowHandle, RawWindowHandle};
+use std::time::Instant;
+use windows::Win32::Foundation::HWND;
+use windows::Win32::UI::WindowsAndMessaging::{IsIconic, IsWindowVisible, SetPhysicalCursorPos, ShowCursor};
+
+#[derive(Default)]
+pub(super) struct Owner {
+    pub frames: Mutex<FrameProtocol>,
+    pub close: Mutex<CloseProtocol>,
+}
+
+impl Owner {
+    pub fn shutdown(&self) {
+        self.frames.lock().shutdown();
+        self.close.lock().replace(false);
+    }
+}
+
+pub(super) struct FrameDispatch {
+    ticket: FrameTicket,
+    timestamp_ms: f64,
+}
+
+type FrameTsfn = ThreadsafeFunction<FrameDispatch, (), (), napi::Status, false, true, 1>;
+type CloseTsfn = ThreadsafeFunction<Token, (), (), napi::Status, false, true, 1>;
+
+pub(super) struct FrameHandler {
+    pub generation: u64,
+    callback: FrameTsfn,
+}
+
+pub(super) struct CloseHandler {
+    pub generation: u64,
+    callback: CloseTsfn,
+}
+
+pub(super) fn frame_handler(
+    env: &Env,
+    callback: FunctionRef<f64, ()>,
+    owner: Arc<Owner>,
+    sender: mpsc::UnboundedSender<UiCommand>,
+) -> Result<FrameHandler> {
+    // The trampoline performs cancellation before invoking the real JS listener.
+    // Neither its callback nor its completion ever waits for the UI thread.
+    let noop = env.create_function_from_closure::<(), (), _>("gpuixFrameDispatch", |_| Ok(()))?;
+    let callback = noop.build_threadsafe_function::<FrameDispatch>()
+        .weak::<true>().max_queue_size::<1>()
+        .build_callback(move |ctx| {
+            let dispatch = ctx.value;
+            let valid = owner.frames.lock().valid(dispatch.ticket);
+            if valid {
+                if let Err(error) = callback.borrow_back(&ctx.env)
+                    .and_then(|callback| callback.call(dispatch.timestamp_ms)) {
+                    log::error!("Windows frame callback failed: {error}");
+                }
+            }
+            sender.unbounded_send(UiCommand::WindowsFrameComplete(dispatch.ticket)).ok();
+            Ok(())
+        })?;
+    Ok(FrameHandler { generation: 0, callback })
+}
+
+pub(super) fn close_handler(
+    env: &Env,
+    callback: FunctionRef<(), bool>,
+    owner: Arc<Owner>,
+    sender: mpsc::UnboundedSender<UiCommand>,
+) -> Result<CloseHandler> {
+    let noop = env.create_function_from_closure::<(), (), _>("gpuixCloseDispatch", |_| Ok(()))?;
+    let callback = noop.build_threadsafe_function::<Token>()
+        .weak::<true>().max_queue_size::<1>()
+        .build_callback(move |ctx| {
+            let token = ctx.value;
+            let valid = owner.close.lock().valid(token);
+            let allow = valid && match callback.borrow_back(&ctx.env)
+                .and_then(|callback| callback.call(())) {
+                Ok(allow) => allow,
+                Err(error) => {
+                    log::error!("Windows close callback failed: {error}");
+                    false
+                }
+            };
+            sender.unbounded_send(UiCommand::WindowsCloseComplete { token, allow }).ok();
+            Ok(())
+        })?;
+    Ok(CloseHandler { generation: 0, callback })
+}
+
+#[derive(Default)]
+struct HiddenCursor {
+    counter: CursorCounter,
+}
+
+impl HiddenCursor {
+    fn hide(&mut self) {
+        self.counter.hide(|visible| unsafe { ShowCursor(visible) });
+    }
+
+    fn restore(&mut self) {
+        self.counter.restore(|visible| unsafe { ShowCursor(visible) });
+    }
+}
+
+impl Drop for HiddenCursor {
+    fn drop(&mut self) { self.restore(); }
+}
+
+struct Bridge {
+    owner: Arc<Owner>,
+    animation: Option<FrameHandler>,
+    resume: Option<FrameHandler>,
+    close: Option<CloseHandler>,
+    close_requested: bool,
+    animation_scheduled: bool,
+    origin: Instant,
+    last_resume_generation: u64,
+    last_active: bool,
+    last_visible: bool,
+    cursor: HiddenCursor,
+    activation: Option<gpui::Subscription>,
+}
+
+thread_local! {
+    static BRIDGE: RefCell<Option<Rc<RefCell<Bridge>>>> = const { RefCell::new(None) };
+}
+
+fn bridge() -> Option<Rc<RefCell<Bridge>>> {
+    BRIDGE.with(|stored| stored.borrow().clone())
+}
+
+impl Bridge {
+    fn observe(&mut self, window: &gpui::Window) {
+        let generation = window.resume_generation();
+        let active = window.is_window_active();
+        let visible = visible(window);
+        if (visible && (generation != self.last_resume_generation || !self.last_visible))
+            || (active && !self.last_active) {
+            self.owner.frames.lock().request_resume();
+        }
+        self.last_resume_generation = generation;
+        self.last_active = active;
+        self.last_visible = visible;
+        if !active { self.cursor.restore(); }
+    }
+
+    fn dispatch(&mut self, kind: FrameKind) {
+        let handler = match kind {
+            FrameKind::Animation => self.animation.as_ref(),
+            FrameKind::Resume => self.resume.as_ref(),
+        };
+        let Some(handler) = handler else { return };
+        let ticket = {
+            let mut state = self.owner.frames.lock();
+            if !state.current(kind, handler.generation) { return; }
+            state.begin(kind)
+        };
+        let Some(ticket) = ticket else { return };
+        let status = handler.callback.call(FrameDispatch {
+            ticket,
+            timestamp_ms: self.origin.elapsed().as_secs_f64() * 1000.0,
+        }, ThreadsafeFunctionCallMode::NonBlocking);
+        if status != napi::Status::Ok {
+            // Closing/queue-full cannot leave a presentation gate waiting on an ack.
+            let mut state = self.owner.frames.lock();
+            state.complete(ticket);
+            state.replace(kind, false);
+            log::error!("Windows frame dispatch failed: {status}");
+        }
+    }
+}
+fn visible(window: &gpui::Window) -> bool {
+    let Ok(handle) = HasWindowHandle::window_handle(window) else { return false };
+    let RawWindowHandle::Win32(handle) = handle.as_raw() else { return false };
+    let hwnd = HWND(handle.hwnd.get() as *mut std::ffi::c_void);
+    unsafe { IsWindowVisible(hwnd).as_bool() && !IsIconic(hwnd).as_bool() }
+}
+
+
+pub(super) fn install(
+    owner: Arc<Owner>,
+    window: &mut gpui::Window,
+    cx: &mut gpui::Context<GpuixView>,
+) {
+    let activation = cx.observe_window_activation(window, |_, window, _| {
+        if let Some(bridge) = bridge() { bridge.borrow_mut().observe(window); }
+        window.refresh();
+    });
+    let value = Rc::new(RefCell::new(Bridge {
+        owner,
+        animation: None,
+        resume: None,
+        close: None,
+        close_requested: false,
+        animation_scheduled: false,
+        origin: Instant::now(),
+        last_resume_generation: window.resume_generation(),
+        last_active: window.is_window_active(),
+        last_visible: visible(window),
+        cursor: HiddenCursor::default(),
+        activation: Some(activation),
+    }));
+    BRIDGE.with(|stored| *stored.borrow_mut() = Some(value));
+    window.on_before_present(Some(Box::new(|window, _cx| {
+        let Some(bridge) = bridge() else { return true };
+        let mut bridge = bridge.borrow_mut();
+        bridge.observe(window);
+        bridge.dispatch(FrameKind::Resume);
+        let deferred = bridge.owner.frames.lock().defer_present();
+        !deferred
+    })));
+    window.on_window_should_close(cx, |_, _| request_close());
+}
+
+pub(super) fn set_frame_handler(
+    kind: FrameKind,
+    handler: Option<FrameHandler>,
+    generation: u64,
+    window: &mut gpui::Window,
+) {
+    if let Some(bridge) = bridge() {
+        let mut bridge = bridge.borrow_mut();
+        if !bridge.owner.frames.lock().current(kind, generation) { return; }
+        match kind {
+            FrameKind::Animation => bridge.animation = handler,
+            FrameKind::Resume => {
+                bridge.resume = handler;
+                bridge.last_resume_generation = window.resume_generation();
+                bridge.last_active = window.is_window_active();
+                bridge.last_visible = visible(window);
+            }
+        }
+    }
+    window.resume_presentation();
+    schedule_animation(window);
+}
+
+pub(super) fn schedule_animation(window: &gpui::Window) {
+    // Named `shared`, not `bridge`: the closure below calls the `bridge()` function again, and a
+    // local named `bridge` would shadow it (E0618).
+    let Some(shared) = bridge() else { return };
+    let mut value = shared.borrow_mut();
+    if value.animation_scheduled || !value.owner.frames.lock().needs_animation() { return; }
+    value.animation_scheduled = true;
+    drop(value);
+    window.on_next_frame(|window, _cx| {
+        let Some(bridge) = bridge() else { return };
+        let mut bridge = bridge.borrow_mut();
+        bridge.animation_scheduled = false;
+        bridge.observe(window);
+        // Resume always takes priority over the ordinary frame callback.
+        bridge.dispatch(FrameKind::Resume);
+        bridge.dispatch(FrameKind::Animation);
+    });
+}
+
+pub(super) fn complete_frame(ticket: FrameTicket, window: &mut gpui::Window, cx: &mut gpui::App) {
+    let completed = bridge().is_some_and(|bridge| {
+        let value = bridge.borrow();
+        let completed = value.owner.frames.lock().complete(ticket);
+        completed
+    });
+    if completed {
+        if let Some(root) = window.root::<GpuixView>().flatten() { cx.notify(root.entity_id()); }
+        window.resume_presentation();
+        schedule_animation(window);
+    }
+}
+
+pub(super) fn set_close_handler(handler: CloseHandler) {
+    let requested = if let Some(bridge) = bridge() {
+        let mut bridge = bridge.borrow_mut();
+        let current = bridge.owner.close.lock().current(handler.generation);
+        if !current { return; }
+        bridge.close = Some(handler);
+        bridge.close_requested
+    } else { false };
+    if requested { request_close(); }
+}
+
+fn request_close() -> bool {
+    let Some(bridge) = bridge() else { return true };
+    let mut bridge = bridge.borrow_mut();
+    let owner = bridge.owner.clone();
+    let mut close = owner.close.lock();
+    if !close.registered() { return true; }
+    bridge.close_requested = true;
+    let Some(handler) = bridge.close.as_ref() else { return false };
+    if !close.current(handler.generation) { return false; }
+    if let Some(token) = close.begin() {
+        let status = handler.callback.call(token, ThreadsafeFunctionCallMode::NonBlocking);
+        if status != napi::Status::Ok {
+            close.complete(token, false);
+            log::error!("Windows close dispatch failed: {status}");
+        }
+        bridge.close_requested = false;
+    } else {
+        bridge.close_requested = !close.pending_is_current();
+    }
+    false
+}
+
+pub(super) fn complete_close(token: Token, allow: bool, window: &mut gpui::Window) {
+    let allowed = bridge().is_some_and(|bridge| {
+        let value = bridge.borrow();
+        let allowed = value.owner.close.lock().complete(token, allow);
+        allowed
+    });
+    if allowed {
+        shutdown(window);
+        window.remove_window();
+    } else if bridge().is_some_and(|bridge| bridge.borrow().close_requested) {
+        request_close();
+    }
+}
+
+pub(super) fn hide_cursor(window: &gpui::Window) {
+    if window.is_window_active() {
+        if let Some(bridge) = bridge() { bridge.borrow_mut().cursor.hide(); }
+    }
+}
+
+pub(super) fn restore_cursor(x: i32, y: i32) {
+    if let Err(error) = unsafe { SetPhysicalCursorPos(x, y) } {
+        log::error!("Restoring drag cursor position failed: {error}");
+    }
+    if let Some(bridge) = bridge() { bridge.borrow_mut().cursor.restore(); }
+}
+
+pub(super) fn shutdown(window: &mut gpui::Window) {
+    clear();
+    window.on_before_present(None);
+    window.resume_presentation();
+}
+
+pub(super) fn clear() {
+    BRIDGE.with(|stored| {
+        if let Some(bridge) = stored.borrow_mut().take() {
+            let mut bridge = bridge.borrow_mut();
+            bridge.owner.shutdown();
+            bridge.animation = None;
+            bridge.resume = None;
+            bridge.close = None;
+            bridge.activation = None;
+            bridge.cursor.restore();
+        }
+    });
+}
diff --git a/packages/native/src/windows_protocol.rs b/packages/native/src/windows_protocol.rs
new file mode 100644
index 0000000..cb95569
--- /dev/null
+++ b/packages/native/src/windows_protocol.rs
@@ -0,0 +1,316 @@
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum FrameKind {
+    Animation,
+    Resume,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Token {
+    pub generation: u64,
+    serial: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct FrameTicket {
+    pub kind: FrameKind,
+    pub token: Token,
+    activation_generation: u64,
+}
+
+#[derive(Default)]
+struct Listener {
+    generation: u64,
+    registered: bool,
+}
+
+pub(super) struct FrameProtocol {
+    animation: Listener,
+    resume: Listener,
+    active: bool,
+    alive: bool,
+    serial: u64,
+    activation_generation: u64,
+    in_flight: Option<FrameTicket>,
+    resume_pending: bool,
+}
+
+impl Default for FrameProtocol {
+    fn default() -> Self {
+        Self {
+            animation: Listener::default(),
+            resume: Listener::default(),
+            active: false,
+            alive: true,
+            serial: 0,
+            in_flight: None,
+            resume_pending: false,
+            activation_generation: 0,
+        }
+    }
+}
+
+impl FrameProtocol {
+    fn listener(&self, kind: FrameKind) -> &Listener {
+        match kind {
+            FrameKind::Animation => &self.animation,
+            FrameKind::Resume => &self.resume,
+        }
+    }
+
+    pub fn replace(&mut self, kind: FrameKind, registered: bool) -> u64 {
+        let listener = match kind {
+            FrameKind::Animation => &mut self.animation,
+            FrameKind::Resume => &mut self.resume,
+        };
+        listener.generation += 1;
+        listener.registered = registered;
+        let generation = listener.generation;
+        if kind == FrameKind::Resume {
+            self.resume_pending = false;
+        }
+        generation
+    }
+
+    pub fn current(&self, kind: FrameKind, generation: u64) -> bool {
+        self.alive && self.listener(kind).generation == generation
+    }
+
+    pub fn set_active(&mut self, active: bool) {
+        if self.active != active {
+            self.activation_generation += 1;
+            self.active = active;
+        }
+    }
+    pub fn request_resume(&mut self) {
+        if self.alive && self.resume.registered {
+            self.resume_pending = true;
+        }
+    }
+
+    pub fn defer_present(&self) -> bool {
+        self.alive && self.resume.registered && (self.resume_pending
+            || self.in_flight.is_some_and(|ticket| ticket.kind == FrameKind::Resume && self.valid(ticket)))
+    }
+
+    pub fn needs_animation(&self) -> bool {
+        self.alive && self.active && self.animation.registered
+            && self.in_flight.is_none() && !self.resume_pending
+    }
+
+    pub fn begin(&mut self, kind: FrameKind) -> Option<FrameTicket> {
+        let wanted = match kind {
+            FrameKind::Animation => self.needs_animation(),
+            FrameKind::Resume => self.defer_present(),
+        };
+        if !wanted || self.in_flight.is_some() {
+            return None;
+        }
+        self.serial += 1;
+        let ticket = FrameTicket {
+            kind,
+            token: Token { generation: self.listener(kind).generation, serial: self.serial },
+            activation_generation: self.activation_generation,
+        };
+        self.in_flight = Some(ticket);
+        if kind == FrameKind::Resume {
+            self.resume_pending = false;
+        }
+        Some(ticket)
+    }
+
+    pub fn valid(&self, ticket: FrameTicket) -> bool {
+        self.alive && self.in_flight == Some(ticket)
+            && self.listener(ticket.kind).registered
+            && self.listener(ticket.kind).generation == ticket.token.generation
+            && (ticket.kind == FrameKind::Resume
+                || (self.active && ticket.activation_generation == self.activation_generation))
+    }
+
+    pub fn complete(&mut self, ticket: FrameTicket) -> bool {
+        if self.in_flight != Some(ticket) {
+            return false;
+        }
+        self.in_flight = None;
+        true
+    }
+
+    pub fn shutdown(&mut self) {
+        self.alive = false;
+        self.resume_pending = false;
+        self.animation.registered = false;
+        self.resume.registered = false;
+    }
+}
+
+#[derive(Default)]
+pub(super) struct CloseProtocol {
+    generation: u64,
+    serial: u64,
+    pending: Option<Token>,
+    registered: bool,
+}
+
+impl CloseProtocol {
+    pub fn replace(&mut self, registered: bool) -> u64 {
+        self.generation += 1;
+        self.registered = registered;
+        self.generation
+    }
+
+    pub fn current(&self, generation: u64) -> bool {
+        self.generation == generation && self.registered
+    }
+
+    pub fn registered(&self) -> bool { self.registered }
+
+    pub fn pending_is_current(&self) -> bool {
+        self.registered && self.pending.is_some_and(|token| token.generation == self.generation)
+    }
+
+    pub fn begin(&mut self) -> Option<Token> {
+        if !self.registered || self.pending.is_some() {
+            return None;
+        }
+        self.serial += 1;
+        let token = Token { generation: self.generation, serial: self.serial };
+        self.pending = Some(token);
+        Some(token)
+    }
+
+    pub fn valid(&self, token: Token) -> bool {
+        self.registered && self.pending == Some(token) && self.generation == token.generation
+    }
+
+    pub fn complete(&mut self, token: Token, allow: bool) -> bool {
+        if self.pending != Some(token) { return false; }
+        let allowed = allow && self.valid(token);
+        self.pending = None;
+        allowed
+    }
+}
+
+#[derive(Default)]
+pub(super) struct CursorCounter {
+    decrements: u32,
+}
+
+impl CursorCounter {
+    pub fn hide(&mut self, mut show: impl FnMut(bool) -> i32) {
+        if self.decrements != 0 { return; }
+        loop {
+            let count = show(false);
+            self.decrements += 1;
+            if count < 0 { break; }
+        }
+    }
+
+    pub fn restore(&mut self, mut show: impl FnMut(bool) -> i32) {
+        for _ in 0..std::mem::take(&mut self.decrements) { show(true); }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pause_and_replacement_cancel_but_keep_one_in_flight_until_ack() {
+        let mut state = FrameProtocol::default();
+        state.replace(FrameKind::Animation, true);
+        state.set_active(true);
+        let old = state.begin(FrameKind::Animation).unwrap();
+        state.set_active(false);
+        state.set_active(true);
+        assert!(!state.valid(old));
+        assert!(state.begin(FrameKind::Animation).is_none());
+        assert!(state.complete(old));
+        let current = state.begin(FrameKind::Animation).unwrap();
+        assert!(!state.complete(old));
+        assert!(state.valid(current));
+        state.replace(FrameKind::Animation, false);
+        assert!(!state.valid(current));
+        assert!(state.complete(current));
+        assert!(!state.needs_animation());
+    }
+
+    #[test]
+    fn resume_defers_until_matching_completion_and_unregister_releases_gate() {
+        let mut state = FrameProtocol::default();
+        state.replace(FrameKind::Resume, true);
+        state.request_resume();
+        assert!(state.defer_present());
+        let ticket = state.begin(FrameKind::Resume).unwrap();
+        assert!(state.defer_present());
+        assert!(state.begin(FrameKind::Resume).is_none());
+        assert!(state.complete(ticket));
+        assert!(!state.defer_present());
+        state.request_resume();
+        let stale = state.begin(FrameKind::Resume).unwrap();
+        state.replace(FrameKind::Resume, false);
+        assert!(!state.defer_present());
+        assert!(!state.valid(stale));
+        state.complete(stale);
+        state.replace(FrameKind::Resume, true);
+        state.request_resume();
+        let closing = state.begin(FrameKind::Resume).unwrap();
+        state.shutdown();
+        assert!(!state.defer_present());
+        assert!(!state.valid(closing));
+        assert!(state.begin(FrameKind::Resume).is_none());
+    }
+
+    #[test]
+    fn resume_waits_for_animation_ack_without_queuing_another_callback() {
+        let mut state = FrameProtocol::default();
+        state.replace(FrameKind::Animation, true);
+        state.replace(FrameKind::Resume, true);
+        state.set_active(true);
+        let frame = state.begin(FrameKind::Animation).unwrap();
+        state.request_resume();
+        assert!(state.defer_present());
+        assert!(state.begin(FrameKind::Resume).is_none());
+        state.complete(frame);
+        assert!(!state.needs_animation());
+        assert!(state.begin(FrameKind::Resume).is_some());
+    }
+
+    #[test]
+    fn close_coalesces_and_rejects_old_handlers_and_responses() {
+        let mut state = CloseProtocol::default();
+        state.replace(true);
+        let stale = state.begin().unwrap();
+        assert!(state.begin().is_none());
+        state.replace(true);
+        assert!(state.begin().is_none(), "replacement retains the bounded outstanding request");
+        assert!(!state.valid(stale));
+        assert!(!state.complete(stale, true));
+        let current = state.begin().unwrap();
+        assert!(!state.complete(stale, true));
+        assert!(state.valid(current));
+        assert!(!state.complete(current, false));
+        let allowed = state.begin().unwrap();
+        assert!(state.complete(allowed, true));
+        assert!(!state.complete(allowed, true));
+    }
+
+    #[test]
+    fn cursor_hide_is_idempotent_and_restores_only_owned_decrements() {
+        for initial in [-2, 0, 3] {
+            let mut counter = CursorCounter::default();
+            let count = std::cell::Cell::new(initial);
+            let mut show = |visible: bool| {
+                count.set(count.get() + if visible { 1 } else { -1 });
+                count.get()
+            };
+            counter.hide(&mut show);
+            let hidden = count.get();
+            assert!(hidden < 0);
+            counter.hide(&mut show);
+            assert_eq!(count.get(), hidden);
+            counter.restore(&mut show);
+            counter.restore(&mut show);
+            assert_eq!(count.get(), initial);
+            assert_eq!(counter.decrements, 0);
+        }
+    }
+}
