+    #[gpui::test]
+    fn flush_effects_production_mode_defers_draw_to_scheduled_frame(cx: &mut TestAppContext) {
+        cx.update(|app| app.mode = super::GpuiMode::Production);
+        let render_count = Rc::new(Cell::new(0));
+        let window = cx.add_window({
+            let render_count = render_count.clone();
+            move |_, _| RenderCounter(render_count)
+        });
+        let test_window = cx.test_window(window.into());
+
+        while test_window.simulate_scheduled_frame() {}
+        let invalidator = cx.update(|app| {
+            window
+                .update(app, |_, window, _| window.invalidator.clone())
+                .unwrap()
+        });
+        assert!(!invalidator.is_dirty());
+        let renders_before_updates = render_count.get();
+        assert!(renders_before_updates > 0);
+
+        for _ in 0..4 {
+            cx.update(|app| {
+                window
+                    .update(app, |_, window, _| {
+                        window.refresh();
+                        assert!(window.invalidator.is_dirty());
+                    })
+                    .unwrap();
+            });
+            assert_eq!(
+                render_count.get(),
+                renders_before_updates,
+                "production App::update must not synchronously render a dirty window"
+            );
+            assert!(
+                invalidator.is_dirty(),
+                "production effect flushing must leave drawing to the frame callback"
+            );
+            assert!(
+                test_window.frame_scheduled(),
+                "production effect flushing must schedule the normal platform frame"
+            );
+        }
+
+        assert!(test_window.simulate_scheduled_frame());
+        assert_eq!(
+            render_count.get(),
+            renders_before_updates + 1,
+            "the next normal frame must coalesce all pending window updates"
+        );
+        assert!(!invalidator.is_dirty());
+        while test_window.simulate_scheduled_frame() {}
+        assert_eq!(render_count.get(), renders_before_updates + 1);
+    }
