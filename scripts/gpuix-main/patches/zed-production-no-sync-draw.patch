+    #[gpui::test]
+    fn flush_effects_test_mode_draws_synchronously(cx: &mut TestAppContext) {
+        cx.update(|app| app.mode = super::GpuiMode::test());
+        let render_count = Rc::new(Cell::new(0));
+        let window = cx.add_window({
+            let render_count = render_count.clone();
+            move |_, _| RenderCounter(render_count)
+        });
+        let test_window = cx.test_window(window.into());
+
+        while test_window.simulate_scheduled_frame() {}
+        let invalidator = cx.update(|app| {
+            window
+                .update(app, |_, window, _| window.invalidator.clone())
+                .unwrap()
+        });
+        assert!(!invalidator.is_dirty());
+        let renders_before_updates = render_count.get();
+        assert!(renders_before_updates > 0);
+
+        for update_count in 1..=4 {
+            cx.update(|app| {
+                window
+                    .update(app, |_, window, _| {
+                        window.refresh();
+                        assert!(window.invalidator.is_dirty());
+                        assert_eq!(
+                            render_count.get(),
+                            renders_before_updates + update_count - 1,
+                            "the nested window update must not flush before the outer App::update"
+                        );
+                    })
+                    .unwrap();
+            });
+            assert_eq!(
+                render_count.get(),
+                renders_before_updates + update_count,
+                "test-mode App::update must synchronously render each dirty window"
+            );
+            assert!(
+                !invalidator.is_dirty(),
+                "test-mode effect flushing must finish drawing before returning"
+            );
+            assert!(test_window.frame_scheduled());
+        }
+
+        while test_window.simulate_scheduled_frame() {}
+        assert_eq!(render_count.get(), renders_before_updates + 4);
+    }
