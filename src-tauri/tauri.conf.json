{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "zoeydaw",
  "version": "0.0.0",
  "identifier": "com.zoeydaw.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/audio/build-plugin-helper.mjs && pnpm --filter @zoeydaw/web dev",
    "beforeBuildCommand": "node scripts/audio/build-plugin-helper.mjs && pnpm --filter @zoeydaw/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zoeydaw",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff",
        "visible": true,
        "trafficLightPosition": { "x": 16, "y": 22 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": { "plugin-helper/": "plugin-helper/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QTIyOTVDNkExQjQyNzcKUldSM1FodHFYQ21pZGFFalVYS29Zb0MwYmNnSGRUbmVLZ2M4aFdOWGUwRllwTGVQYncyMTlFWS8K",
      "endpoints": [
        "https://github.com/zoeymind/zoeydaw/releases/latest/download/latest.json"
      ]
    }
  }
}
